
# Build Artifacts
.agent/
.agent
build*
.*cache
_deps/
*.pc
*_include.cmake
*Config.cmake
*ConfigVersion.cmake
compile_commands.json
.claude/
.gemini/
.history/
.DS_Store


# Programming Languages Artifacts
# Python
bindings/python/build/
**/__pycache__/
*.so
*.dylib
*.pyd
venv/
.venv/
.pytest_cache/


# Rust
bindings/rust/target/
**/Cargo.lock
# ...but commit the binding crate's lock so CI resolves the cxx / cxx-build
# family to a single, internally-consistent version. Without it, cargo re-resolves
# them to drifting 1.0.x patches and the cxxbridge mangling numbers mismatch
# (undefined `qbuem$rust$cxxbridge1$NNN$*` symbols → bench fails to link).
!bindings/rust/Cargo.lock

# Node.js
**/node_modules/
dist/
out/
 
 # Go
 bindings/go/bin/
 bindings/go/vendor/
 *.test
 *.exe
 *.out


# IDEs
.vscode/
.idea/

# Large Files & Data
# Keep config JSONs, ignore test data
*.json
!package.json
!**/package.json
!package-lock.json
!**/package-lock.json
!tests/small.json
!tests/test_*.json
!docs/public/benchmark-results.json
# Specifically ignore large benchmark/test files
tests/test_large.json
tests/test_uint64.json
twitter.json
canada.json
citm_catalog.json
gsoc-2018.json

# Doxygen generated output (built during CI, not committed)
docs/api/html/
docs/api/reference/

# Temporary Scripts & Logs
*.log
*.tmp
# *.py - Keep benchmarks and utility scripts
# __pycache__/ - Covered above
# **/node_modules - Covered above
bindings/python/build/
bindings/rust/target/
bindings/go/qbuem_json.test

# Fuzzing
fuzz/*.profraw
fuzz/*.profdata
fuzz/coverage_report/
fuzz/corpus_fuzz_*/
# Locally-grown libFuzzer corpus (SHA1-named entries). The curated named seeds
# below stay tracked; new named seeds need `git add -f`.
fuzz/corpus/*
!fuzz/corpus/false
!fuzz/corpus/float_val
!fuzz/corpus/mixed
!fuzz/corpus/ndjson-null-doc-regression
!fuzz/corpus/nested_array
!fuzz/corpus/nested_object
!fuzz/corpus/null
!fuzz/corpus/simple_array
!fuzz/corpus/simple_object
!fuzz/corpus/simple_string
!fuzz/corpus/true
!fuzz/corpus/unicode_string
!fuzz/corpus/zero
crash-*
oom-*
leak-*
timeout-*
